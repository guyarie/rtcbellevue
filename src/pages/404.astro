---
import Base from '../layouts/Base.astro';
import { getLabels } from '../lib/site';
const t = await getLabels();
---
<Base title={t('not_found_title')}>
  <section class="section">
    <div class="container-x text-center">
      <h1>{t('not_found_title')}</h1>
      <p class="mt-4">{t('not_found_body')}</p>
      <p class="mt-8"><a class="btn" href="/">{t('not_found_link')}</a></p>
    </div>
  </section>
</Base>
