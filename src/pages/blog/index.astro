---
import { getCollection, getEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { getLabels } from '../../lib/site';

const page = await getEntry('pages', 'blog');
if (!page) throw new Error('src/content/pages/blog.md is missing');
const t = await getLabels();
const posts = (await getCollection('posts', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date);
const authors = Object.fromEntries((await getCollection('clinicians')).map((c) => [c.id, c.data.name]));
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
---

<Base title={page.data.title} description={page.data.description}>
  {page.data.sections.map((s, i) => <Section section={s} first={i === 0} />)}
  <section class="section">
    <div class="container-x post-list">
      {posts.map((p) => (
        <article class="post-card">
          {p.data.image && <a href={`/blog/${p.id}`}><Image src={p.data.image} alt={p.data.image_alt ?? ''} width={800} /></a>}
          <p class="post-meta">{fmt(p.data.date)} · {t('blog_by', { author: authors[p.data.author.id] ?? '' })}</p>
          <h2 class="!text-2xl mt-2"><a href={`/blog/${p.id}`}>{p.data.title}</a></h2>
          <p class="mt-2">{p.data.description}</p>
          <a class="btn btn--small mt-4" href={`/blog/${p.id}`}>{t('blog_read_more')}</a>
        </article>
      ))}
    </div>
  </section>
</Base>
