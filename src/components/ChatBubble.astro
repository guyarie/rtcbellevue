---
// Floating chat bubble, on every page when `chat_url` is set in site/settings.md.
// The chat iframe loads on first open (it focuses its message box as it loads).
// Any link to `#chat` opens it, e.g. the "Start a chat" card on /contact-us.
import { getSettings, getLabels } from '../lib/site';

const settings = await getSettings();
const t = await getLabels();
---

{settings.chat_url && (
  <div class="chat-bubble" data-chat>
    <div class="chat-bubble__panel" id="chat-panel" role="dialog" aria-label={t('chat_open')} hidden>
      <button type="button" class="chat-bubble__close" data-chat-close aria-label={t('chat_close')}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" /></svg>
      </button>
      <iframe data-src={settings.chat_url} title={t('chat_open')}></iframe>
    </div>
    <button type="button" class="chat-bubble__toggle" data-chat-toggle aria-expanded="false" aria-controls="chat-panel">
      <svg class="chat-bubble__icon-open" viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v8a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 4v-4h0A1.5 1.5 0 0 1 4 14.5z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" /></svg>
      <svg class="chat-bubble__icon-close" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      <span class="chat-bubble__label">{t('chat_open')}</span>
    </button>
  </div>
)}

<script>
  const root = document.querySelector<HTMLElement>('[data-chat]');
  if (root) {
    const panel = root.querySelector<HTMLElement>('.chat-bubble__panel')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-chat-toggle]')!;
    const frame = root.querySelector<HTMLIFrameElement>('iframe')!;

    const setOpen = (open: boolean) => {
      if (open && !frame.src) frame.src = frame.dataset.src!;
      panel.hidden = !open;
      root.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      if (!open) toggle.focus();
    };

    toggle.addEventListener('click', () => setOpen(panel.hidden));
    root.querySelector('[data-chat-close]')!.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      const a = (e.target as Element).closest?.('a[href="#chat"]');
      if (!a) return;
      e.preventDefault();
      setOpen(true);
    });
    if (location.hash === '#chat') setOpen(true);
  }
</script>
