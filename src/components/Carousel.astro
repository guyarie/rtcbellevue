---
// Horizontal scroll-snap carousel with prev/next buttons (like the old site's card sliders).
import { getLabels } from '../lib/site';
export interface Props { class?: string; label?: string }
const { class: cls = '', label } = Astro.props;
const t = await getLabels();
---
<div class:list={['carousel', cls]} data-carousel role="region" aria-label={label}>
  <div class="carousel__track" tabindex="0"><slot /></div>
  <div class="carousel__nav">
    <button type="button" data-dir="-1" aria-label={t('carousel_prev')}>←</button>
    <button type="button" data-dir="1" aria-label={t('carousel_next')}>→</button>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((c) => {
    const track = c.querySelector<HTMLElement>('.carousel__track')!;
    const [prev, next] = c.querySelectorAll<HTMLButtonElement>('[data-dir]');
    // Hide an arrow when the first / last card is already fully in view.
    const first = track.firstElementChild, last = track.lastElementChild;
    if (first && last && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => entries.forEach((e) => {
          (e.target === first ? prev : next).disabled = e.intersectionRatio > 0.9;
        }),
        { root: track, threshold: [0, 0.9, 1] },
      );
      io.observe(first);
      io.observe(last);
    }
    c.querySelectorAll<HTMLButtonElement>('[data-dir]').forEach((b) =>
      b.addEventListener('click', () => {
        const item = track.firstElementChild as HTMLElement | null;
        const step = item ? item.getBoundingClientRect().width + 24 : track.clientWidth;
        track.scrollBy({ left: Number(b.dataset.dir) * step, behavior: 'smooth' });
      }),
    );
  });
</script>
