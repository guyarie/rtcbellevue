---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import { getSettings, getLabels } from '../lib/site';

export interface Props {
  title: string;
  description?: string;
  ogImage?: ImageMetadata;
  ogType?: string;
}

const { title, description, ogImage, ogType = 'website' } = Astro.props;
const settings = await getSettings();
const t = await getLabels();

const siteName = settings.name ?? settings.title;
const fullTitle = title.includes(siteName) ? title : `${title}${t('site_suffix')}`;
const site = Astro.site!.href.replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, site).href;
const og = ogImage ?? settings.logo;
const ogImageURL = og ? new URL((await getImage({ src: og, width: Math.min(1200, og.width), format: og === settings.logo ? 'png' : 'jpg' })).src, site).href : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: siteName,
  url: site,
  email: settings.email,
  telephone: settings.phone ? `+1${settings.phone}` : undefined,
  address: {
    '@type': 'PostalAddress',
    streetAddress: settings.address?.slice(0, 2).join(', '),
    addressLocality: 'Bellevue',
    addressRegion: 'WA',
    postalCode: '98007',
    addressCountry: 'US',
  },
  medicalSpecialty: 'Psychiatric',
};
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.png" type="image/png" />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Plausible Analytics (self-hosted, cookieless) — only on the production build -->
    {import.meta.env.PROD && (
      <script defer data-domain="rtcbellevue.com" src="https://analytics.16jets.com/js/script.js"></script>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Almarai:wght@400;700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('skip_link')}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
